# Generate a random secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
DEMO_VIEWER_PASSWORD=change-this-viewer-password
DEMO_REVIEWER_PASSWORD=change-this-reviewer-password
NOTIFICATION_MODE=mock
# For Photon 2.0 Beta, set NOTIFICATION_MODE=photon and fill the values below.
# Use a project-scoped key (pho_sk_...), not an account-wide key, where possible.
PHOTON_API_KEY=
PHOTON_PROJECT_ID=
PHOTON_AGENT_USER_ID=
# Map each internal employee notification channel to the approved Photon destination.
# Example shape: {"mock:employee":{"platform":"email","handle":"person@example.test"}}
PHOTON_CHANNEL_MAP={}
# Optional overrides:
# PHOTON_API_BASE_URL=https://api.photon.codes
# PHOTON_TIMEOUT_SECONDS=15
# Optional; defaults to data/sentinelai.sqlite3
# DATABASE_PATH=data/sentinelai.sqlite3
