NEMOTRON_BASE_URL=
NEMOTRON_API_KEY=
NEMOTRON_MODEL=
EMBEDDING_MODEL=
CHROMA_PERSIST_DIRECTORY=

# Optional API authentication (set these locally before starting FastAPI).
JWT_SECRET_KEY=
DEMO_VIEWER_PASSWORD=
DEMO_REVIEWER_PASSWORD=
# Optional P1/P3 database overrides; omit blank overrides to use defaults.
# DATABASE_URL=sqlite:///./sentinelai.db
# DATABASE_PATH=./data/sentinelai.sqlite3
# NOTIFICATION_MODE=mock

# Photon Beta iMessage delivery (used when NOTIFICATION_MODE=photon).
# Project API key with project:read + project:write, from app.beta.photon.codes -> API keys.
# PHOTON_API_KEY=
# PHOTON_PROJECT_ID=pho_prj_...
# Demo routing: map each fictional employee to a real demo iPhone (E.164, with + and country code).
# PHOTON_RECIPIENTS=EMP-001=+1...,EMP-003=+1...,EMP-006=+1...
# Optional fallback phone for employees not listed above.
# PHOTON_DEMO_HANDLE=+1...
# Every phone must be assigned in the Photon dashboard and must text the Photon number once first.
